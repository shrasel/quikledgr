# ==============================================================================
# QuikLedgr — Global Environment Configuration
# ==============================================================================

COMPOSE_PROJECT_NAME=quikledgr

# Application Environment
NODE_ENV=production
PORT=5000
WEB_PORT=8085

# MariaDB Configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=quikledgr_db
DB_USER=quikledgr_user
DB_PASSWORD=quikledgr_secure_pass_2026
DB_ROOT_PASSWORD=quikledgr_root_secret_2026

# JWT Authentication Secret
JWT_SECRET=quikledgr_super_secure_jwt_token_key_change_in_production

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Frontend Application URL (for CORS)
CLIENT_URL=http://localhost:8085
